GHCR_STATS_OWNER=Ploos-AS
GHCR_STATS_INTERVAL=6h
GHCR_STATS_LISTEN=:8080
GHCR_STATS_DB=/data/ghcr-stats.db

# Optional snapshot retention. Empty/0 disables automatic pruning.
# Minimum accepted value is 24h. One boundary baseline per package is retained.
GHCR_STATS_RETENTION=

# Automatic discovery: set a GitHub token and leave GHCR_STATS_PACKAGES empty.
# Conservative choice: a classic PAT with read:packages. Do not rely on a
# repository Actions GITHUB_TOKEN for organization-wide package enumeration.
GHCR_STATS_GITHUB_TOKEN=
# Prefer this instead of GHCR_STATS_GITHUB_TOKEN when using a mounted secret file:
GHCR_STATS_GITHUB_TOKEN_FILE=

# Optional explicit override. When non-empty, automatic discovery is disabled.
GHCR_STATS_PACKAGES=
