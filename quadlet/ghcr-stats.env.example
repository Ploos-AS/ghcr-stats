GHCR_STATS_OWNER=Ploos-AS
GHCR_STATS_INTERVAL=6h
GHCR_STATS_PACKAGES=

# Optional snapshot retention. Empty/0 disables automatic pruning.
# Minimum accepted value is 24h. One boundary baseline per package is retained.
GHCR_STATS_RETENTION=

# Optional automatic discovery. Prefer GHCR_STATS_GITHUB_TOKEN_FILE with a
# read-only bind mount or Podman secret in local deployment overrides.
GHCR_STATS_GITHUB_TOKEN=
GHCR_STATS_GITHUB_TOKEN_FILE=

# Normally keep the SQLite database in the persistent /data mount.
GHCR_STATS_DB=/data/ghcr-stats.db
GHCR_STATS_LISTEN=:8080
